ARG UBUNTU_VERSION
FROM ubuntu:${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    autopkgtest bash-completion build-essential ca-certificates cmake debhelper-compat \
    devscripts dpkg-dev g++ jq libapt-pkg-dev lintian ninja-build pkg-config \
    python3 python3-jsonschema rsync && \
    rm -rf /var/lib/apt/lists/*

COPY docker/entrypoint-test.sh /usr/local/bin/upgrade-guard-container-test
RUN chmod 0755 /usr/local/bin/upgrade-guard-container-test
ENTRYPOINT ["/usr/local/bin/upgrade-guard-container-test"]
